# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY -- never expose this to the browser.
# Used for admin actions (approving accounts, managing other students).
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
