# --- Supabase -------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY -- never expose this to the browser.
# Used for admin actions (creating a profile at sign-up, adding a student).
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app. Used for links inside notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Email notifications (Resend) ------------------------------------------
# Optional. Leave blank and the app runs fine, just without notifications --
# every attempt is written to cars_email_log either way.

# From the Resend dashboard.
RESEND_API_KEY=

# Sender. The domain must be verified in Resend.
# e.g. "YGEP Car Rental <cars@ygep.org>"
EMAIL_FROM=

# Who in the office gets notified. Comma separated for more than one.
# Extra addresses can also be added in the portal under Settings.
OFFICE_NOTIFICATION_EMAILS=
